{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotePlus+",
  "version": "0.1.6",
  "identifier": "cn.noteplus.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NotePlus+",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["underWindowBackground", "acrylic"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "© 2026 NotePlus+",
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "locales/en.lproj/Localizable.strings": "en.lproj/Localizable.strings",
      "locales/zh_CN.lproj/Localizable.strings": "zh_CN.lproj/Localizable.strings",
      "locales/zh_TW.lproj/Localizable.strings": "zh_TW.lproj/Localizable.strings"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    }
  }
}
