{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "NotePlus+ main window and find dialog capabilities",
  "windows": ["main", "find"],
  "permissions": ["core:default", "core:window:allow-close", "core:window:allow-start-dragging", "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-is-maximized", "dialog:default", "clipboard-manager:allow-read-text", "clipboard-manager:allow-write-text"]
}
